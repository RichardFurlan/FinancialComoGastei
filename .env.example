# Copie este arquivo para .env e preencha os valores antes de rodar docker compose up

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=comogasto_db

# --- Mensageria (RabbitMQ) ---
RABBITMQ_USER=cgmg_user
RABBITMQ_PASS=YOUR_RABBITMQ_PASSWORD

# --- OpenRouter (DeepSeek) ---
# Chave da API: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# --- Cloudflare Tunnel ---
# Token gerado em: Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create Tunnel
# Deixe em branco se não for usar o tunnel (o serviço cloudflared simplesmente não subirá corretamente)
CF_TUNNEL_TOKEN=
